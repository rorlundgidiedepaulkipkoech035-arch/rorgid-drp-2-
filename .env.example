# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).
SECRET_KEY=put-a-long-random-string-here
ADMIN_EMAIL=you@yourdomain.com
ADMIN_PASSWORD=Use-A-Strong-Pass1!
SMTP_SERVER=smtp.yourprovider.com
SMTP_PORT=587
SMTP_SENDER=security@yourdomain.com
SMTP_PASSWORD=your-app-password
KECIRT_REPORT_TO=official-kecirt-reporting-address
DRP_AUTO_REPORT=false
COOKIE_SECURE=false
